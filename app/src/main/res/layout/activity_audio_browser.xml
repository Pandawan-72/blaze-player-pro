<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- Carte premium navigateur audio : navigation + sources + actions + tri regroupés -->
    <LinearLayout
        android:id="@+id/audioBrowserHeaderCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:background="@drawable/bg_header_premium"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <!-- Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_header_action_button"
                android:contentDescription="@string/content_desc_back"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/tvBrowserTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/add_tracks"
                android:textColor="@color/on_background"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnWatchedHelp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_header_action_button"
                android:contentDescription="@string/audio_watched_help_button_desc"
                android:padding="9dp"
                android:src="@drawable/ic_help_circle"
                android:tint="@color/on_surface_variant"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_header_action_button"
                android:contentDescription="@string/breadcrumb_home"
                android:padding="9dp"
                android:src="@drawable/ic_home"
                android:tint="@color/on_surface_variant" />

        </LinearLayout>

        <!-- Sources -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLocal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/tab_local"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/green_accent"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_smartphone"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="@color/black" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNetwork"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/tab_network"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/blue_accent"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_network"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="@color/black" />

        </LinearLayout>

        <!-- Actions d'ajout rapide -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddAll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/select_all"
                android:textColor="@color/on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/surface_variant"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_check_circle"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="@color/on_surface"
                app:strokeColor="@color/green_accent"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/queue_short"
                android:textColor="@color/on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/surface_variant"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_add_circle"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="@color/on_surface"
                app:strokeColor="@color/blue_accent"
                app:strokeWidth="1dp" />

        </LinearLayout>

        <!-- Playlists sauvegardées / Blaze Party -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddToSavedPlaylist"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/add_to_playlist_short"
                android:textColor="@color/on_surface"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/surface_variant"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_layout_list"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="@color/on_surface"
                app:strokeColor="@color/on_surface_variant"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddToBlazeParty"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/add_to_party_short"
                android:textColor="#FFFFC107"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/surface_variant"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_equalizer"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="#FFFFC107"
                app:strokeColor="#FFFFC107"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Compteur + tri -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSelected"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:text="@string/no_track_found"
                android:textColor="@color/green_accent"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/audioSortChip"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_premium_sort_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:elevation="3dp"
                android:stateListAnimator="@animator/premium_pill_state_animator"
                android:clipToOutline="true">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_equalizer"
                    android:tint="@color/green_accent" />

                <TextView
                    android:id="@+id/tvSortLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="3dp"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:text="@string/name_label"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnSortChevron"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:clickable="true"
                    android:contentDescription="@string/content_desc_sort"
                    android:focusable="true"
                    android:src="@drawable/ic_chevron_down"
                    android:tint="@color/on_surface_variant" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- LISTE : collée au bas de la carte -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAudio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="8dp"
        android:clipToPadding="false" />

</LinearLayout>
