<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <!-- Barre du haut -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btnEditorClose"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_close"
            android:src="@drawable/ic_close"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/photo_editor_title"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnEditorSave"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_save"
            android:src="@drawable/ic_check"
            android:tint="@color/green_accent" />
    </LinearLayout>

    <!-- Zone image -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <ImageView
            android:id="@+id/ivPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <fr.retrospare.blazeplayer.gallery.edit.CropOverlayView
            android:id="@+id/cropOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <fr.retrospare.blazeplayer.gallery.edit.BlurSelectionView
            android:id="@+id/blurOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/editorProgress"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/green_accent"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompareHold"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:includeFontPadding="false"
            android:text="@string/action_compare_hold"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="14dp"
            app:backgroundTint="#66000000"
            app:cornerRadius="22dp"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp" />
    </FrameLayout>

    <!-- Panneau Filtres -->
    <HorizontalScrollView
        android:id="@+id/filterPanel"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:scrollbars="none"
        android:paddingVertical="8dp">

        <LinearLayout
            android:id="@+id/filterStrip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp" />
    </HorizontalScrollView>

    <!-- Panneau Recadrage -->
    <LinearLayout
        android:id="@+id/cropPanel"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRatioFree"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="4dp"
                    android:includeFontPadding="false"
                    android:text="@string/crop_ratio_free"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#33FFFFFF"
                    app:strokeColor="@color/green_accent"
                    app:strokeWidth="2dp"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRatioSquare"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="4dp"
                    android:includeFontPadding="false"
                    android:text="@string/crop_ratio_square"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#33FFFFFF"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="0dp"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRatio43"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="4dp"
                    android:includeFontPadding="false"
                    android:text="@string/crop_ratio_4_3"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#33FFFFFF"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="0dp"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRatio169"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="4dp"
                    android:includeFontPadding="false"
                    android:text="@string/crop_ratio_16_9"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#33FFFFFF"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="0dp"
                    app:cornerRadius="22dp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Panneau Rotation -->
    <LinearLayout
        android:id="@+id/rotatePanel"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnRotateLeft"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_rotate_left"
            android:src="@drawable/ic_rotate_left"
            android:tint="#FFFFFF" />

        <SeekBar
            android:id="@+id/seekStraighten"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:max="90"
            android:progress="45"
            android:progressTint="@color/green_accent"
            android:thumbTint="@color/green_accent" />

        <ImageButton
            android:id="@+id/btnRotateRight"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_rotate_right"
            android:src="@drawable/ic_rotate_right"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Panneau Flou -->
    <LinearLayout
        android:id="@+id/blurPanel"
        android:layout_width="match_parent"
        android:layout_height="184dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/blur_enable_label"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-condensed" />

            <Switch
                android:id="@+id/switchBlurEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/green_accent"
                android:trackTint="#664D9A75" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEffectBlur"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:includeFontPadding="false"
                android:text="@string/blur_effect_blur"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#33FFFFFF"
                app:strokeColor="@color/green_accent"
                app:strokeWidth="2dp"
                app:cornerRadius="22dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEffectMosaic"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:includeFontPadding="false"
                android:text="@string/blur_effect_mosaic"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#33FFFFFF"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="0dp"
                app:cornerRadius="22dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShapeCircle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:includeFontPadding="false"
                android:text="@string/blur_shape_circle"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#33FFFFFF"
                app:strokeColor="@color/green_accent"
                app:strokeWidth="2dp"
                app:icon="@drawable/ic_shape_circle"
                app:iconSize="14dp"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart"
                app:cornerRadius="22dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShapeSquare"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:includeFontPadding="false"
                android:text="@string/blur_shape_square"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#33FFFFFF"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="0dp"
                app:icon="@drawable/ic_shape_square"
                app:iconSize="14dp"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart"
                app:cornerRadius="22dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/blur_intensity_label"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-condensed" />

            <SeekBar
                android:id="@+id/seekBlurIntensity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:max="100"
                android:progress="50"
                android:progressTint="@color/green_accent"
                android:thumbTint="@color/green_accent" />
        </LinearLayout>
    </LinearLayout>

    <!-- Barre d'onglets outils -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#0D0F14">

        <LinearLayout
            android:id="@+id/tabFilters"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_tune"
                android:tint="@color/green_accent"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/editor_tab_filters"
                android:textColor="@color/green_accent"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabCrop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_aspect_ratio"
                android:tint="@color/on_surface_variant"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/editor_tab_crop"
                android:textColor="@color/on_surface_variant"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabRotate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_rotate_left"
                android:tint="@color/on_surface_variant"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/editor_tab_rotate"
                android:textColor="@color/on_surface_variant"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabBlur"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_blur"
                android:tint="@color/on_surface_variant"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/editor_tab_blur"
                android:textColor="@color/on_surface_variant"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
