<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_surface_card"
    android:clipToOutline="true"
    android:minHeight="66dp"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_icon_blue"
        android:layout_marginEnd="10dp">

        <ImageView
            android:id="@+id/ivShareIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_wifi"
            android:tint="@color/blue_accent"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvShareName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface"
            android:textSize="13sp"
            android:fontFamily="sans-serif-condensed"
            android:ellipsize="end"
            android:singleLine="true"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tvShareUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface_variant"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:ellipsize="end"
            android:singleLine="true"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="5dp">

            <TextView
                android:id="@+id/tvBadgeType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_blue"
                android:paddingHorizontal="7dp"
                android:paddingVertical="1dp"
                android:textColor="@color/blue_accent"
                android:textSize="9sp"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBrowse"
        android:includeFontPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="@string/test_network_path"
        android:textSize="11sp"
        android:fontFamily="sans-serif-condensed"
        android:textColor="#FF000000"
        android:paddingHorizontal="10dp"
        android:singleLine="true"
        android:ellipsize="end"
        app:icon="@drawable/ic_wifi"
        app:iconSize="14dp"
        app:iconTint="#FF000000"
        app:iconGravity="textStart"
        app:backgroundTint="@color/blue_accent"
        app:cornerRadius="17dp"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

    <ImageButton
        android:id="@+id/btnEdit"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_more_vert"
        android:tint="@color/on_surface_variant"
        android:contentDescription="@string/content_desc_options" />

</LinearLayout>
