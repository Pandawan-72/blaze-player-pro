<?xml version="1.0" encoding="utf-8"?>
<fr.retrospare.blazeplayer.ui.SquareRoundedFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp"
    android:padding="0dp"
    android:background="@drawable/bg_gallery_tile_card"
    android:elevation="4dp"
    android:translationZ="2dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:id="@+id/galleryFolderPreviewGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical"
        android:padding="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="0dp">

            <ImageView
                android:id="@+id/ivPreview1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/ivPreview2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="1dp"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="1dp"
            android:orientation="horizontal"
            android:padding="0dp">

            <ImageView
                android:id="@+id/ivPreview3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/ivPreview4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="1dp"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="9dp"
        android:paddingTop="6dp"
        android:paddingEnd="3dp"
        android:paddingBottom="6dp"
        android:background="@drawable/bg_gallery_tile_overlay">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFolderName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-condensed"
                android:singleLine="true"
                android:textColor="@color/on_surface"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvFolderCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/on_surface_variant"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnFolderMore"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_options"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/on_surface_variant" />
    </LinearLayout>
</fr.retrospare.blazeplayer.ui.SquareRoundedFrameLayout>
