<?xml version="1.0" encoding="utf-8"?>
<fr.retrospare.blazeplayer.ui.SquareRoundedFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp"
    android:padding="0dp"
    android:background="@drawable/bg_gallery_tile_card"
    android:elevation="4dp"
    android:translationZ="2dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:id="@+id/galleryFolderPreviewGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="horizontal"
        android:padding="0dp">

        <ImageView
            android:id="@+id/ivPreview1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="1dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivPreview2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/ivPreview3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="1dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/ivGalleryFolderIcon"
        android:layout_width="68.4dp"
        android:layout_height="68.4dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_gallery_folder_filled"
        android:visibility="visible" />

    <TextView
        android:id="@+id/tvFolderCount"
        android:layout_width="46dp"
        android:layout_height="34dp"
        android:layout_gravity="center"
        android:autoSizeMaxTextSize="20sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FF202124"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="9dp"
        android:paddingTop="3dp"
        android:paddingEnd="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/bg_gallery_tile_overlay">

        <TextView
            android:id="@+id/tvFolderName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnFolderMore"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_options"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/on_surface_variant" />
    </LinearLayout>
</fr.retrospare.blazeplayer.ui.SquareRoundedFrameLayout>
