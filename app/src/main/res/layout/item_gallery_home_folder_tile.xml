<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp">

    <!-- Même largeur, rayon et liseré que les cartes de l'accueil Blaze Video. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/galleryFolderCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/outline_variant"
        app:strokeWidth="1dp">

        <!-- La tuile complète reste strictement carrée malgré la nouvelle carte extérieure. -->
        <fr.retrospare.blazeplayer.ui.SquareRoundedFrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface">

            <!-- Une grande photo à gauche et deux photos superposées à droite. -->
            <LinearLayout
                android:id="@+id/galleryFolderPreviewGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FF000000"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivPreview1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/bg_thumbnail" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="1dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivPreview2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/bg_thumbnail" />

                    <ImageView
                        android:id="@+id/ivPreview3"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="1dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/bg_thumbnail" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/ivGalleryFolderIcon"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_gallery_folder_filled"
                android:visibility="visible" />

            <TextView
                android:id="@+id/tvFolderCount"
                android:layout_width="46dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:autoSizeMaxTextSize="20sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FF202124"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="128" />

            <!-- Bandeau inférieur identique dans son rythme aux légendes des cartes Blaze Video. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_gallery_tile_overlay"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="2dp">

                <TextView
                    android:id="@+id/tvFolderName"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center_vertical|start"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/on_background"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Vacances en Bretagne" />

                <ImageButton
                    android:id="@+id/btnFolderMore"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/content_desc_options"
                    android:padding="7dp"
                    android:src="@drawable/ic_more_vert"
                    android:tint="@color/on_surface" />
            </LinearLayout>
        </fr.retrospare.blazeplayer.ui.SquareRoundedFrameLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
