<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="?attr/selectableItemBackground">

    <fr.retrospare.blazeplayer.ui.RoundedFrameLayout
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:padding="3dp"
        android:background="@drawable/bg_gallery_photo_card"
        android:elevation="4dp"
        android:translationZ="2dp">

        <fr.retrospare.blazeplayer.ui.RoundedImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <CheckBox
            android:id="@+id/cbSelected"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:buttonTint="@color/green_accent"
            android:visibility="gone" />
    </fr.retrospare.blazeplayer.ui.RoundedFrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/on_surface"
            android:textSize="11sp"
            android:fontFamily="sans-serif-condensed" />

        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/on_surface_variant"
            android:contentDescription="@string/content_desc_options" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/on_surface_variant"
        android:textSize="10sp" />
</LinearLayout>
