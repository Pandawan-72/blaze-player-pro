<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="24dp">

            <!-- HERO HEADER -->
            <LinearLayout
                android:id="@+id/settingsHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_audio_pro_hero"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="46dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_header_action_button"
                        android:contentDescription="@string/action_back"
                        android:padding="9dp"
                        android:src="@drawable/ic_arrow_back"
                        android:tint="@color/on_surface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-condensed"
                                android:includeFontPadding="false"
                                android:text="@string/settings"
                                android:textColor="@color/on_background"
                                android:textSize="26sp"
                                android:textStyle="bold" />


                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:maxLines="2"
                            android:text="@string/app_name"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- PRO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_audio_pro_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/btnBecomePro"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_pro_banner"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-condensed"
                        android:includeFontPadding="false"
                        android:text="@string/upgrade_to_pro"
                        android:textColor="@color/on_background"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/on_surface_variant" />

                </LinearLayout>

            </LinearLayout>

            <!-- SECTION LECTURE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_audio_pro_card"
                android:orientation="vertical">

                <TextView
                    style="@style/BlazeSettingsSectionTitle"
                    android:text="@string/settings_section_playback" />

                <View style="@style/BlazeSettingsSeparator" />

                <include android:id="@+id/settingResume" layout="@layout/item_setting" />
                <View style="@style/BlazeSettingsSeparator" />
                <include android:id="@+id/settingAutoPlay" layout="@layout/item_setting" />
                <View style="@style/BlazeSettingsSeparator" />
                <include android:id="@+id/settingSpeed" layout="@layout/item_setting" />
                <View style="@style/BlazeSettingsSeparator" />
                <include android:id="@+id/settingSeekTime" layout="@layout/item_setting" />
                <View style="@style/BlazeSettingsSeparator" />
                <include android:id="@+id/settingOrientation" layout="@layout/item_setting" />
                <View style="@style/BlazeSettingsSeparator" />
                <include android:id="@+id/settingPip" layout="@layout/item_setting" />

            </LinearLayout>

            <!-- SECTION AUDIO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_audio_pro_card"
                android:orientation="vertical">

                <TextView
                    style="@style/BlazeSettingsSectionTitle"
                    android:text="@string/settings_section_audio" />

                <View style="@style/BlazeSettingsSeparator" />

                <include android:id="@+id/settingAudioLang" layout="@layout/item_setting" />

            </LinearLayout>

            <!-- SECTION INTERFACE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_audio_pro_card"
                android:orientation="vertical">

                <TextView
                    style="@style/BlazeSettingsSectionTitle"
                    android:text="@string/interface_section" />

                <View style="@style/BlazeSettingsSeparator" />

                <include android:id="@+id/settingAccentColor" layout="@layout/item_setting" />
                <View style="@style/BlazeSettingsSeparator" />
                <include android:id="@+id/settingShowHidden" layout="@layout/item_setting" />
                <View style="@style/BlazeSettingsSeparator" />
                <include android:id="@+id/settingHaptic" layout="@layout/item_setting" />

            </LinearLayout>

            <!-- SECTION DONNÉES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_audio_pro_card"
                android:orientation="vertical">

                <TextView
                    style="@style/BlazeSettingsSectionTitle"
                    android:text="@string/data_section" />

                <View style="@style/BlazeSettingsSeparator" />

                <include android:id="@+id/settingClearHistory" layout="@layout/item_setting" />

            </LinearLayout>

            <!-- SECTION À PROPOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_audio_pro_card"
                android:orientation="vertical">

                <TextView
                    style="@style/BlazeSettingsSectionTitle"
                    android:text="@string/about_section" />

                <View style="@style/BlazeSettingsSeparator" />

                <include android:id="@+id/settingAbout" layout="@layout/item_setting" />
                <View style="@style/BlazeSettingsSeparator" />
                <include android:id="@+id/settingLanguage" layout="@layout/item_setting" />

            </LinearLayout>

            <!-- SECTION CONTACT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_audio_pro_card"
                android:orientation="vertical">

                <TextView
                    style="@style/BlazeSettingsSectionTitle"
                    android:text="@string/contact_section" />

                <View style="@style/BlazeSettingsSeparator" />

                <include android:id="@+id/settingSuggestions" layout="@layout/item_setting" />
                <View style="@style/BlazeSettingsSeparator" />
                <include android:id="@+id/settingReportBug" layout="@layout/item_setting" />

            </LinearLayout>

            <!-- RESTAURER ACHATS -->
            <LinearLayout
                android:id="@+id/btnRestorePurchases"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_audio_pro_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_refresh"
                    android:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:text="@string/restore_purchases"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- NOTER L'APPLICATION -->
            <LinearLayout
                android:id="@+id/btnRateApp"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_audio_pro_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_star"
                    android:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-condensed"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/settings_rate_app"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/settings_rate_app_desc"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/on_surface_variant" />

            </LinearLayout>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
