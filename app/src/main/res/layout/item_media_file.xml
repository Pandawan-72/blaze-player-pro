<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="4dp"
    android:minHeight="84dp"
    android:background="@drawable/bg_media_card"
    android:elevation="2dp"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp">

    <CheckBox
        android:id="@+id/checkboxSelect"
        style="@style/Widget.BlazePlayer.MultiSelectCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:visibility="gone" />

    <!-- Ligne compacte : titre et métadonnées à gauche, petite frame vidéo portrait à droite. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="start"
        android:orientation="vertical">

        <fr.retrospare.blazeplayer.ui.StrictTwoLineTextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:breakStrategy="simple"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center_vertical|start"
            android:hyphenationFrequency="none"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:minLines="2"
            android:textColor="@color/on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Conteneur, codec vidéo, codec audio et durée, dans cet ordre. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFormat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvVideoCodec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_badge_gray"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/on_surface_variant"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAudioCodec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_badge_gray"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/on_surface_variant"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_gray"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/on_surface_variant"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Aperçu vidéo volontairement étroit et vertical : une frame des dix premières secondes
         est recadrée sans prendre la largeur de la ligne. Le menu reste l'action la plus à droite. -->
    <FrameLayout
        android:id="@+id/thumbnailContainer"
        android:layout_width="46dp"
        android:layout_height="68dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_thumbnail"
        android:clipToOutline="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/ivPlayOverlay"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:alpha="0.82"
            android:contentDescription="@null"
            android:src="@drawable/ic_play_small"
            android:visibility="gone" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btnMore"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/content_desc_options"
        android:padding="6dp"
        android:src="@drawable/ic_more_vert"
        android:tint="@color/on_surface_variant" />

    <TextView
        android:id="@+id/tvResolution"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvAudioQuality"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/progressFill"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
