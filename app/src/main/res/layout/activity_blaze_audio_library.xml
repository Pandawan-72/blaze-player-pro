<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/libraryRoot"
    android:saveEnabled="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/libraryScreenContainer"
        android:saveEnabled="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/libraryHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="46dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnBack"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_audio_library_action_button"
                            android:contentDescription="@string/action_back"
                            android:padding="9dp"
                            android:src="@drawable/ic_arrow_back"
                            android:tint="@color/on_surface" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvLibraryTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-condensed"
                                    android:includeFontPadding="false"
                                    android:text="@string/audio_library_title"
                                    android:textColor="@color/on_background"
                                    android:textSize="28sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/badgeLibraryPro"
                                    android:layout_width="wrap_content"
                                    android:layout_height="24dp"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/bg_audio_library_pill"
                                    android:fontFamily="sans-serif-condensed"
                                    android:gravity="center"
                                    android:includeFontPadding="false"
                                    android:paddingHorizontal="8dp"
                                    android:text="@string/version_badge_pro_plus"
                                    android:textColor="@color/audio_library_accent"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvLibrarySubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif"
                                android:maxLines="2"
                                android:text="@string/audio_library_subtitle"
                                android:textColor="@color/audio_library_text_muted"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btnSearch"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_audio_library_action_button"
                            android:contentDescription="@string/audio_search"
                            android:padding="9dp"
                            android:src="@drawable/ic_search"
                            android:tint="@color/on_surface" />

                        <ImageButton
                            android:id="@+id/btnSettings"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_audio_library_action_button"
                            android:contentDescription="@string/audio_settings_title"
                            android:padding="9dp"
                            android:src="@drawable/ic_settings"
                            android:tint="@color/on_surface" />

                    </LinearLayout>

                    <View
                        android:id="@+id/dividerLibraryHero"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_audio_library_section_divider" />

                    <LinearLayout
                    android:id="@+id/libraryMiniPlayer"
                    android:layout_width="match_parent"
                    android:layout_marginTop="12dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_audio_library_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="9dp"
                    android:visibility="visible">

                    <FrameLayout
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginEnd="12dp">

                        <fr.retrospare.blazeplayer.ui.RoundedImageView
                            android:id="@+id/ivLibraryMiniArtwork"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_audio_cover_placeholder"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop" />

                        <View
                            android:id="@+id/libraryMiniEqOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#66000000"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/libraryMiniPlayingIndicator"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_playing_spinner"
                            android:visibility="gone" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLibraryMiniTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-condensed"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/audio_no_current_track"
                            android:textColor="@color/on_surface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLibraryMiniArtist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-condensed"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text=""
                            android:textColor="@color/audio_library_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvLibraryMiniTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-condensed"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/zero_time"
                            android:textColor="@color/on_surface_secondary"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnLibraryMiniPrev"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/content_desc_previous"
                            android:padding="8dp"
                            android:src="@drawable/ic_skip_previous"
                            android:tint="@color/on_surface" />

                        <ImageButton
                            android:id="@+id/btnLibraryMiniPlayPause"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/content_desc_play_pause"
                            android:padding="8dp"
                            android:src="@drawable/ic_pause"
                            android:tint="@color/on_surface" />

                        <ImageButton
                            android:id="@+id/btnLibraryMiniNext"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/content_desc_next"
                            android:padding="8dp"
                            android:src="@drawable/ic_skip_next"
                            android:tint="@color/on_surface" />

                    </LinearLayout>

                </LinearLayout>

                    <LinearLayout
                        android:id="@+id/albumStickyHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone" />


                </LinearLayout>

        <LinearLayout
            android:id="@+id/libraryGlobalCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="0dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/watchedSummaryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:id="@+id/iconWatchedFolders"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_audio_library_pill"
                        android:padding="6dp"
                        android:src="@drawable/ic_folder_open"
                        android:tint="@color/audio_library_accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-condensed"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/audio_watched_folders"
                            android:textColor="@color/on_background"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvWatchedSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:maxLines="2"
                            android:textColor="@color/audio_library_text_muted"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnManualScan"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_audio_library_pill"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="12dp"
                        android:text="@string/action_refresh"
                        android:textColor="@color/audio_library_accent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                    android:foreground="@drawable/bg_premium_pill_foreground"
                    android:foregroundGravity="fill"
                    android:clipToOutline="true"
                    android:elevation="3dp"
                    android:stateListAnimator="@animator/premium_pill_state_animator" />

                    <TextView
                        android:id="@+id/btnManageWatched"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_audio_library_pill"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="12dp"
                        android:text="@string/action_manage"
                        android:textColor="@color/audio_library_accent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                    android:foreground="@drawable/bg_premium_pill_foreground"
                    android:foregroundGravity="fill"
                    android:clipToOutline="true"
                    android:elevation="3dp"
                    android:stateListAnimator="@animator/premium_pill_state_animator" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabContainer"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_audio_library_pill"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="4dp"
                    android:visibility="gone" />

<LinearLayout
                    android:id="@+id/libraryStats"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <TextView
                        android:id="@+id/tvTrackCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="22dp"
                        android:background="#22FFFFFF" />

                    <TextView
                        android:id="@+id/tvAlbumCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="22dp"
                        android:background="#22FFFFFF" />

                    <TextView
                        android:id="@+id/tvArtistCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

<View
                    android:id="@+id/dividerLibraryStats"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_audio_library_section_divider"
                    android:visibility="gone" />

                <View
                    android:id="@+id/dividerLibraryResume"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_audio_library_section_divider"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/resumeSectionHeader"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-condensed"
                        android:includeFontPadding="false"
                        android:id="@+id/tvResumeTitle"
                        android:text="@string/audio_resume_listening"
                        android:textColor="@color/on_background"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/resumeScroll"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/resumeContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

                <View
                    android:id="@+id/dividerLibraryAlbums"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_audio_library_section_divider"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/albumsSectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-condensed"
                        android:includeFontPadding="false"
                        android:id="@+id/tvAlbumsTitle"
                        android:text="@string/audio_recent_albums"
                        android:textColor="@color/on_background"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Toggle de tri Album/Artiste supprimé : la bibliothèque trie toujours les
                         albums par nom d'artiste alphabétique, sans réglage utilisateur. Les ids
                         tvAlbumSortMode/switchAlbumSortMode restent en tant que vues invisibles
                         0dp pour ne pas casser les références R.id.* encore présentes en code. -->
                    <TextView
                        android:id="@+id/tvAlbumSortMode"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAlbumSortMode"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/albumViewModeContainer"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvAlbumViewGrid3"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_audio_library_pill"
                            android:fontFamily="sans-serif-condensed"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="10dp"
                            android:text="@string/audio_album_view_grid_3"
                            android:textColor="@color/audio_library_accent"
                            android:textSize="13sp"
                            android:textStyle="bold"
                    android:foreground="@drawable/bg_premium_pill_foreground"
                    android:foregroundGravity="fill"
                    android:clipToOutline="true"
                    android:elevation="3dp"
                    android:stateListAnimator="@animator/premium_pill_state_animator" />

                        <TextView
                            android:id="@+id/tvAlbumViewGrid4"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_audio_library_pill"
                            android:fontFamily="sans-serif-condensed"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="10dp"
                            android:text="@string/audio_album_view_grid_4"
                            android:textColor="@color/audio_library_accent"
                            android:textSize="13sp"
                            android:textStyle="bold"
                    android:foreground="@drawable/bg_premium_pill_foreground"
                    android:foregroundGravity="fill"
                    android:clipToOutline="true"
                    android:elevation="3dp"
                    android:stateListAnimator="@animator/premium_pill_state_animator" />

                        <TextView
                            android:id="@+id/tvAlbumViewList"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_audio_library_pill"
                            android:fontFamily="sans-serif-condensed"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="10dp"
                            android:text="@string/audio_album_view_list"
                            android:textColor="@color/audio_library_accent"
                            android:textSize="13sp"
                            android:textStyle="bold"
                    android:foreground="@drawable/bg_premium_pill_foreground"
                    android:foregroundGravity="fill"
                    android:clipToOutline="true"
                    android:elevation="3dp"
                    android:stateListAnimator="@animator/premium_pill_state_animator" />

                    </LinearLayout>

                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/albumsScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/albumsContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

                <View
                    android:id="@+id/dividerLibraryTracks"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_audio_library_section_divider"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/tracksSectionHeader"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-condensed"
                        android:includeFontPadding="false"
                        android:id="@+id/tvTracksTitle"
                        android:text="@string/audio_played_tracks"
                        android:textColor="@color/on_background"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSortMode"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_audio_library_pill"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/sort_album_order"
                        android:textColor="@color/audio_library_accent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                    android:foreground="@drawable/bg_premium_pill_foreground"
                    android:foregroundGravity="fill"
                    android:clipToOutline="true"
                    android:elevation="3dp"
                    android:stateListAnimator="@animator/premium_pill_state_animator" />

                </LinearLayout>

        </LinearLayout>

        <!-- Seule zone scrollable de l'écran : "Dossiers surveillés", les onglets, les compteurs
             et le titre "Mes albums" + toggle (dans libraryGlobalCard ci-dessus) restent fixes ;
             le RecyclerView ajouté ici en code (buildUi()) remplit tout l'espace restant et gère
             lui-même son propre scroll — plus de ScrollView englobante, donc plus de double-scroll
             imbriqué entre elle et le RecyclerView. -->
        <LinearLayout
            android:id="@+id/tracksContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:orientation="vertical" />

    </LinearLayout>

</FrameLayout>
