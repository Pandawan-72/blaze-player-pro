<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_surface_card"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/on_surface_variant"
            android:contentDescription="Retour" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginHorizontal="10dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/movies"
                android:textColor="@color/on_background"
                android:textSize="15sp"
                android:fontFamily="sans-serif-condensed"
                android:ellipsize="end"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tvPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/example_smb_path"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:ellipsize="end"
                android:singleLine="true"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnToggleAudio"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_surface_card"
            android:src="@drawable/ic_audio"
            android:tint="@color/on_surface_variant"
            android:contentDescription="Afficher fichiers audio" />

        <ImageButton
            android:id="@+id/btnSearch"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_surface_card"
            android:src="@drawable/ic_search"
            android:tint="@color/on_surface_variant"
            android:contentDescription="Rechercher" />

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_surface_card"
            android:src="@drawable/ic_home"
            android:tint="@color/on_surface_variant"
            android:contentDescription="Accueil" />

    </LinearLayout>

    <!-- BREADCRUMB -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/breadcrumbContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

    </HorizontalScrollView>

    <!-- SORT BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvFileCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="@color/on_surface_variant"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/btnSort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_sort"
                android:tint="@color/on_surface_variant"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvSortLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/sort_name_az"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ACTIONS VIDÉO FIXES -->
    <LinearLayout
        android:id="@+id/videoSelectionActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="10dp"
        android:background="@color/background">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToPlaylist"
            android:includeFontPadding="false"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:text="@string/add_to_playlist_fixed_short"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_add_circle"
            app:iconSize="16dp"
            app:iconTint="@color/green_accent"
            app:iconGravity="textStart"
            app:backgroundTint="@color/surface_variant"
            app:cornerRadius="20dp"
            app:strokeColor="@color/green_accent"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToQueue"
            android:includeFontPadding="false"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:text="@string/add_to_video_queue_short"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_add_circle"
            app:iconSize="16dp"
            app:iconTint="@color/black"
            app:iconGravity="textStart"
            app:backgroundTint="@color/green_accent"
            app:cornerRadius="20dp" />

    </LinearLayout>

    <!-- RECHERCHE -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/search_hint_video"
        android:paddingHorizontal="16dp"
        android:background="@color/surface_variant"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/on_surface_variant"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:singleLine="true"
        android:visibility="gone" />

    <!-- LISTE FICHIERS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="12dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:scrollbars="none" />

</LinearLayout>
