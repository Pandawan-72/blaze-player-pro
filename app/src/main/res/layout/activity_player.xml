<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        app:use_controller="false"
        app:resize_mode="fit"
        app:surface_type="surface_view" />

    <!--
        TextureView de secours pour les réglages d'image premium.
        SurfaceView reste le rendu par défaut car il est plus fluide pour les vidéos réseau.
        Dès qu'un réglage visuel est actif, PlayerActivity bascule temporairement le player ici
        afin d'appliquer un RenderEffect sans pénaliser le mode neutre.
    -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/filteredPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        app:use_controller="false"
        app:resize_mode="fit"
        app:surface_type="texture_view" />

    <View
        android:id="@+id/castBlackout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Overlay premium : top bar sobre, contrôles centraux, timeline + panneau bas compact. -->
    <FrameLayout
        android:id="@+id/uiOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <!-- Voile uniforme des contrôles : 25 % noir, non cliquable pour ne jamais bloquer les boutons. -->
        <View
            android:id="@+id/controlsDimOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#59000000"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <!-- TOP BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_top_icon_btn"
                android:contentDescription="@string/content_desc_back"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCastRemote"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_top_icon_btn"
                android:contentDescription="@string/content_desc_cast_remote"
                android:padding="10dp"
                android:src="@drawable/ic_remote_control"
                android:tint="#FFFFFF" />

            <androidx.mediarouter.app.MediaRouteButton
                android:id="@+id/btnHeaderCast"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_top_icon_btn"
                android:contentDescription="@string/info_dialog_title_chromecast"
                android:padding="9dp"
                app:mediaRouteButtonTint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnVideoSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_top_icon_btn"
                android:contentDescription="@string/video_settings_title"
                android:padding="10dp"
                android:src="@drawable/ic_settings"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <!-- CONTRÔLES CENTRAUX : rewind / play / forward -->
        <LinearLayout
            android:id="@+id/centerTransportControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnRewind"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:alpha="0.82"
                    android:contentDescription="@string/content_desc_rewind"
                    android:src="@drawable/ic_rewind_10"
                    android:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvRewindLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    android:text="−10s"
                    android:textColor="#99FFFFFF"
                    android:textSize="8sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/playPauseStack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="42dp"
                android:layout_marginEnd="42dp"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/btnScreenshot"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_top_icon_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/content_desc_video_screenshot"
                        android:src="@drawable/ic_camera"
                        android:tint="#FFFFFF" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnPlayPause"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:background="@drawable/bg_play_btn_player"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivPlayPause"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/content_desc_play_pause"
                        android:src="@drawable/ic_play"
                        android:tint="#FFFFFF" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnVideoQueue"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_top_icon_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/video_queue_title"
                        android:src="@drawable/ic_layout_list"
                        android:tint="#FFFFFF" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnForward"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:alpha="0.82"
                    android:contentDescription="@string/content_desc_forward"
                    android:src="@drawable/ic_forward_10"
                    android:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvForwardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    android:text="+10s"
                    android:textColor="#99FFFFFF"
                    android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>



        <LinearLayout
            android:id="@+id/castStatusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/bg_dialog_rounded"
            android:clickable="true"
            android:elevation="10dp"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_cast_icon_circle">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/info_dialog_title_chromecast"
                    android:src="@drawable/ic_cast"
                    android:tint="#FFFFFF" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvCastStatusTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/player_casting_in_progress"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvCastDeviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Chromecast"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCastMediaTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="#8CFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnStopCasting"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_cast_stop_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/player_stop_casting"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- BOTTOM : timeline au-dessus, panneau compact bien espacé -->
        <LinearLayout
            android:id="@+id/bottomControlsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:id="@+id/timelineRow"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="0:00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <FrameLayout
                        android:id="@+id/progressContainer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:layout_gravity="center_vertical"
                            android:background="#55FFFFFF" />

                        <View
                            android:id="@+id/progressBuffer"
                            android:layout_width="0dp"
                            android:layout_height="3dp"
                            android:layout_gravity="center_vertical|start"
                            android:background="#40FFFFFF" />

                        <View
                            android:id="@+id/progressFill"
                            android:layout_width="0dp"
                            android:layout_height="3dp"
                            android:layout_gravity="center_vertical|start"
                            android:background="@color/blue_accent" />

                        <View
                            android:id="@+id/progressThumb"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center_vertical|start"
                            android:background="@drawable/bg_progress_thumb" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvTotalTime"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:text="0:00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/btnSeekInfo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/action_information"
                    android:padding="7dp"
                    android:src="@drawable/ic_info"
                    android:tint="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_video_control_panel"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <LinearLayout
                    android:id="@+id/btnSubtitles"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/dialog_title_subtitles"
                        android:src="@drawable/ic_subtitles"
                        android:tint="#E6FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/dialog_title_subtitles"
                        android:textColor="#B3FFFFFF"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnAudio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/category_audio"
                        android:src="@drawable/ic_language"
                        android:tint="#E6FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/category_audio"
                        android:textColor="#B3FFFFFF"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPrevious"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/content_desc_previous"
                        android:src="@drawable/ic_skip_previous"
                        android:tint="#FFFFFF" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnStop"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_play_btn_player"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/content_desc_stop"
                        android:src="@drawable/ic_stop"
                        android:tint="#FFFFFF" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/btnNext"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/content_desc_next"
                        android:src="@drawable/ic_skip_next"
                        android:tint="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSpeed"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSpeedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="1.00×"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/player_speed_label_short"
                        android:textColor="#B3FFFFFF"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnRatio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/player_ratio_label"
                        android:src="@drawable/ic_aspect_ratio"
                        android:tint="#E6FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/player_ratio_label"
                        android:textColor="#B3FFFFFF"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ZONES GESTUELLES : visibles seulement pendant interaction, hors overlay principal. -->
    <FrameLayout
        android:id="@+id/touchZoneLeft"
        android:layout_width="56dp"
        android:layout_height="210dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="24dp"
        android:background="@drawable/bg_volume_brightness_panel"
        android:clickable="true"
        android:clipToOutline="true"
        android:focusable="true"
        android:paddingTop="18dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_sun"
                android:tint="#FFD43B" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                android:layout_weight="1">

                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="#D9FFFFFF" />

                <View
                    android:id="@+id/touchZoneLeftFill"
                    android:layout_width="3dp"
                    android:layout_height="0dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="#FFD43B" />

                <View
                    android:id="@+id/touchZoneLeftThumb"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/bg_progress_thumb" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvBrightnessZone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/touchZoneRight"
        android:layout_width="56dp"
        android:layout_height="210dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_volume_brightness_panel"
        android:clickable="true"
        android:clipToOutline="true"
        android:focusable="true"
        android:paddingTop="18dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_volume"
                android:tint="#4FC3F7" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                android:layout_weight="1">

                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="#D9FFFFFF" />

                <View
                    android:id="@+id/touchZoneRightFill"
                    android:layout_width="3dp"
                    android:layout_height="0dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="#4FC3F7" />

                <View
                    android:id="@+id/touchZoneRightThumb"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/bg_progress_thumb" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvVolumeZone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/seekIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_seek_indicator"
        android:fontFamily="sans-serif-condensed"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:text="0:00:00"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

</FrameLayout>
