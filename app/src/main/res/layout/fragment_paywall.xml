<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    android:id="@+id/paywallRoot"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_auth">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_surface_card"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/on_surface_variant"
                android:contentDescription="@string/action_back" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingTop="18dp"
            android:paddingBottom="20dp">

            <ImageView
                android:id="@+id/imgAppIcon"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_marginBottom="18dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/paywall_title"
                android:textColor="@color/on_background"
                android:textSize="24sp"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/paywall_subtitle"
                android:textColor="@color/on_surface_variant"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_trial_banner"
            android:padding="12dp"
            android:text="@string/paywall_debug_unlocked"
            android:textColor="@color/green_accent"
            android:textSize="12sp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_surface_card"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/paywall_free_title"
                android:textColor="@color/on_background"
                android:textSize="18sp"
                android:fontFamily="sans-serif-condensed" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/paywall_free_desc"
                android:textColor="@color/on_surface_variant"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.35" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_pro_banner"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/paywall_pro_title"
                    android:textColor="@color/on_background"
                    android:textSize="19sp"
                    android:fontFamily="sans-serif-condensed" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/paywall_pro_price"
                    android:textColor="@color/green_accent"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-condensed" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/paywall_pro_desc"
                android:textColor="@color/on_surface_variant"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.35" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_surface_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/paywall_pro_plus_title"
                    android:textColor="@color/on_background"
                    android:textSize="19sp"
                    android:fontFamily="sans-serif-condensed" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/paywall_pro_plus_price"
                    android:textColor="@color/green_accent"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-condensed" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/paywall_pro_plus_desc"
                android:textColor="@color/on_surface_variant"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.35" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuyPro"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/paywall_buy_pro"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/background_auth"
                app:backgroundTint="@color/green_accent"
                app:cornerRadius="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuyProPlus"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:text="@string/paywall_buy_pro_plus"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/on_background"
                app:backgroundTint="@color/surface"
                app:strokeColor="@color/yellow_accent"
                app:strokeWidth="1.5dp"
                app:cornerRadius="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestore"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:text="@string/paywall_restore"
                android:textSize="13sp"
                android:textColor="@color/on_surface_variant"
                app:strokeColor="@color/outline_variant"
                app:cornerRadius="20dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
