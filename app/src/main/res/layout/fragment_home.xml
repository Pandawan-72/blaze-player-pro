<?xml version='1.0' encoding='utf-8'?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">

    <LinearLayout android:id="@+id/scrollContent" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginBottom="64dp" android:orientation="vertical">

            <!-- HEADER premium : logo, actions, accès rapides et playlists dans une seule carte -->
            <LinearLayout
                android:id="@+id/headerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="0dp"
                android:background="@drawable/bg_header_premium"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp">

                    <ImageView
                        android:id="@+id/ivLogo"
                        android:layout_width="136dp"
                        android:layout_height="48dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:src="@drawable/logo"
                        android:scaleType="fitStart"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvVersionBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/ivLogo"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pro_badge"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="@string/version_badge_free"
                        android:textColor="@color/green_accent"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:includeFontPadding="false"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="Pro+" />

                    <ImageButton
                        android:id="@+id/btnNetworkHelp"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/btnSettings"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_header_action_button"
                        android:padding="8dp"
                        android:src="@drawable/ic_help_circle"
                        android:tint="@color/on_surface"
                        android:contentDescription="@string/network_help_button_desc"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/btnSettings"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_header_action_button"
                        android:padding="8dp"
                        android:src="@drawable/ic_settings"
                        android:tint="@color/on_surface"
                        android:contentDescription="@string/content_desc_settings" />

                    <androidx.mediarouter.app.MediaRouteButton
                        android:id="@+id/btnCast"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/btnSettings"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_header_action_button"
                        android:padding="9dp"
                        app:mediaRouteButtonTint="@color/on_surface"
                        android:contentDescription="@string/info_dialog_title_chromecast" />

                    <ImageButton
                        android:id="@+id/btnCastRemote"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/btnScreenCast"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_header_action_button"
                        android:padding="9dp"
                        android:src="@drawable/ic_remote_control"
                        android:tint="@color/on_surface"
                        android:contentDescription="@string/content_desc_cast_remote" />

                    <ImageButton
                        android:id="@+id/btnScreenCast"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/btnCast"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_header_action_button"
                        android:padding="9dp"
                        android:src="@drawable/ic_screen_cast"
                        android:tint="@color/on_surface"
                        android:contentDescription="@string/content_desc_cast_screen" />

                    <LinearLayout
                        android:id="@+id/galleryTypeHeaderToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/btnSettings"
                        android:layout_marginEnd="8dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:visibility="gone">

                        <ImageButton
                            android:id="@+id/btnGalleryTypePhoto"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="6dp"
                            android:padding="9dp"
                            android:background="@drawable/bg_header_action_button"
                            android:src="@drawable/ic_camera"
                            android:tint="@color/green_accent"
                            android:contentDescription="@string/gallery_type_photo" />

                        <ImageButton
                            android:id="@+id/btnGalleryTypeVideo"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="9dp"
                            android:background="@drawable/bg_header_action_button"
                            android:src="@drawable/ic_video_camera"
                            android:tint="@color/on_surface_variant"
                            android:contentDescription="@string/gallery_type_video" />

                    </LinearLayout>

                </RelativeLayout>

                <!-- Contrôles Réseau : en-tête intégré à la carte premium de Home -->
                <LinearLayout
                    android:id="@+id/headerControlsNetwork"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingStart="4dp"
                            android:paddingEnd="12dp">

                            <TextView
                                android:id="@+id/tvNetworkHeaderTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/local_network_label"
                                android:textColor="@color/on_surface"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-condensed"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:includeFontPadding="false" />

                            <TextView
                                android:id="@+id/tvNetworkHeaderSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/scan_complete"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif-condensed"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:includeFontPadding="false" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNetworkHeaderScan"
                            android:includeFontPadding="false"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="@string/action_scan"
                            android:textSize="13sp"
                            android:textColor="@color/black"
                            android:paddingHorizontal="14dp"
                            app:backgroundTint="@color/green_accent"
                            app:cornerRadius="20dp"
                            app:icon="@drawable/ic_wifi"
                            app:iconSize="15dp"
                            app:iconTint="@color/black"
                            app:iconGravity="textStart"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />
                    </LinearLayout>


                    <!-- Compatibilité binding/code historique réseau : les anciennes actions ne sont plus visibles dans l'onglet Réseau. -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHistoryNetwork"
                            android:layout_width="0dp"
                            android:layout_height="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFavoritesNetwork"
                            android:layout_width="0dp"
                            android:layout_height="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBrowseNetwork"
                            android:layout_width="0dp"
                            android:layout_height="0dp" />

                        <TextView
                            android:id="@+id/btnPlaylistNetwork1"
                            android:layout_width="0dp"
                            android:layout_height="0dp" />

                        <TextView
                            android:id="@+id/btnPlaylistNetwork2"
                            android:layout_width="0dp"
                            android:layout_height="0dp" />

                        <TextView
                            android:id="@+id/btnPlaylistNetwork3"
                            android:layout_width="0dp"
                            android:layout_height="0dp" />

                        <TextView
                            android:id="@+id/btnPlaylistNetwork4"
                            android:layout_width="0dp"
                            android:layout_height="0dp" />

                        <TextView
                            android:id="@+id/btnPlaylistNetwork5"
                            android:layout_width="0dp"
                            android:layout_height="0dp" />

                        <ImageButton
                            android:id="@+id/btnVideoQueueNetwork"
                            android:layout_width="0dp"
                            android:layout_height="0dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Contrôles Local : boutons indépendants, mais regroupés dans la carte premium -->
                <LinearLayout
                    android:id="@+id/headerControlsLocal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHistoryLocal"
                            android:includeFontPadding="false"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="@string/history_blaze_video"
                            android:textSize="13sp"
                            android:textColor="@color/on_surface"
                            android:paddingHorizontal="12dp"
                            app:backgroundTint="@color/surface_variant"
                            app:strokeColor="@color/green_accent_stroke"
                            app:strokeWidth="1dp"
                            app:cornerRadius="20dp"
                            app:icon="@drawable/ic_history"
                            app:iconSize="15dp"
                            app:iconTint="@color/green_accent"
                            app:iconGravity="textStart"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFavoritesLocal"
                            android:includeFontPadding="false"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="8dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="@string/favorites"
                            android:textSize="13sp"
                            android:textColor="@color/on_surface"
                            android:paddingHorizontal="12dp"
                            app:backgroundTint="@color/surface_variant"
                            app:strokeColor="@color/green_accent_stroke"
                            app:strokeWidth="1dp"
                            app:cornerRadius="20dp"
                            app:icon="@drawable/ic_folder"
                            app:iconSize="15dp"
                            app:iconTint="@color/green_accent"
                            app:iconGravity="textStart"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBrowseLocal"
                            android:includeFontPadding="false"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="@string/browse_files_local"
                            android:textSize="13sp"
                            android:textColor="@color/black"
                            android:paddingHorizontal="14dp"
                            app:backgroundTint="@color/green_accent"
                            app:cornerRadius="20dp"
                            app:icon="@drawable/ic_folder_open"
                            app:iconSize="15dp"
                            app:iconTint="@color/black"
                            app:iconGravity="textStart"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/btnPlaylistLocal1"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-condensed"
                            android:textStyle="bold"
                            android:background="@drawable/bg_playlist_chip"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnPlaylistLocal2"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center"
                            android:text="2"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-condensed"
                            android:textStyle="bold"
                            android:background="@drawable/bg_playlist_chip"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnPlaylistLocal3"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-condensed"
                            android:textStyle="bold"
                            android:background="@drawable/bg_playlist_chip"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnPlaylistLocal4"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center"
                            android:text="4"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-condensed"
                            android:textStyle="bold"
                            android:background="@drawable/bg_playlist_chip"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnPlaylistLocal5"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center"
                            android:text="5"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-condensed"
                            android:textStyle="bold"
                            android:background="@drawable/bg_playlist_chip"
                            android:clickable="true"
                            android:focusable="true" />

                        <ImageButton
                            android:id="@+id/btnVideoQueueLocal"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_video_queue_chip"
                            android:src="@drawable/ic_layout_list"
                            android:tint="@color/video_queue_icon_tint"
                            android:padding="8dp"
                            android:contentDescription="@string/content_desc_video_queue" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Contrôles Blaze Gallery : regroupés dans la même carte premium que les autres onglets -->
                <LinearLayout
                    android:id="@+id/headerControlsGallery"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_gallery"
                            android:tint="@color/green_accent"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tvSectionGallery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/gallery_folders"
                            android:textColor="@color/on_surface"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-condensed"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:includeFontPadding="false"
                        android:id="@+id/btnGallerySecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="@string/favorites"
                        android:textSize="13sp"
                        android:textColor="@color/on_surface"
                        android:paddingHorizontal="12dp"
                        app:backgroundTint="@color/surface_variant"
                        app:strokeColor="@color/green_accent_stroke"
                        app:strokeWidth="1dp"
                        app:cornerRadius="20dp"
                        app:icon="@drawable/ic_star"
                        app:iconSize="15dp"
                        app:iconTint="@color/green_accent"
                        app:iconGravity="textStart"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:includeFontPadding="false"
                        android:id="@+id/btnGalleryPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="@string/gallery_trash"
                        android:textSize="13sp"
                        android:textColor="@color/black"
                        android:paddingHorizontal="14dp"
                        app:backgroundTint="@color/green_accent"
                        app:cornerRadius="20dp"
                        app:icon="@drawable/ic_folder_open"
                        app:iconSize="15dp"
                        app:iconTint="@color/black"
                        app:iconGravity="textStart"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                </LinearLayout>
            </LinearLayout>


            <LinearLayout android:id="@+id/sectionNetwork" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:visibility="gone">

                <FrameLayout
                    android:id="@+id/networkConfigContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Vues historiques réseau conservées uniquement pour compatibilité binding/code existant. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listNetwork"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/emptyStateNetwork"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmptyStateBrowseNetwork"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>

            <!-- SECTION LOCAL -->
            <LinearLayout android:id="@+id/sectionLocal" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">

                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/listLocal" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingBottom="24dp" android:clipToPadding="false"/>

                    <LinearLayout android:id="@+id/emptyStateLocal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center" android:paddingHorizontal="32dp" android:visibility="gone">

                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:alpha="0.5" android:src="@drawable/ic_history" android:tint="@color/on_surface_variant" android:contentDescription="@null"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="@string/history_empty_blaze_video_title" android:textColor="@color/on_surface" android:textSize="14sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="@string/history_empty_blaze_video_subtitle" android:textColor="@color/on_surface_variant" android:textSize="12sp" android:fontFamily="sans-serif-condensed"/>

                        <com.google.android.material.button.MaterialButton android:id="@+id/btnEmptyStateBrowseLocal" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginTop="16dp" android:text="@string/browse_files_local" android:textSize="13sp" android:textColor="#FF000000" android:paddingHorizontal="16dp" app:backgroundTint="@color/green_accent" app:cornerRadius="22dp" app:icon="@drawable/ic_folder_open" app:iconSize="14dp" app:iconTint="#FF000000" app:iconGravity="textStart"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"/>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHistoryDeleteOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone"
                        android:elevation="12dp"
                        android:translationZ="16dp"
                        android:includeFontPadding="false"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="@string/action_delete"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="16dp"
                        android:paddingEnd="18dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="@color/red_accent"
                        app:cornerRadius="22dp"
                        app:icon="@drawable/ic_trash"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconTint="@android:color/white" />
                </FrameLayout>

            </LinearLayout>

            <LinearLayout android:id="@+id/sectionGallery" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:visibility="gone">





                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/listGallery" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingBottom="24dp" android:clipToPadding="false"/>

                    <LinearLayout android:id="@+id/emptyStateGallery" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center" android:paddingHorizontal="32dp" android:visibility="gone">

                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:alpha="0.5" android:src="@drawable/ic_folder_open" android:tint="@color/on_surface_variant" android:contentDescription="@null"/>

                        <TextView android:id="@+id/tvEmptyStateGallery" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:textColor="@color/on_surface_variant" android:textSize="13sp" android:fontFamily="sans-serif-condensed"/>
                    </LinearLayout>
                </FrameLayout>

            </LinearLayout>

    </LinearLayout>

    <FrameLayout android:id="@+id/audioContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>

    <!-- Placeholder conservé pour compatibilité avec le code existant -->
    <TextView android:id="@+id/tabAll" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp"/>

    <!-- BOTTOM NAV BAR -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:layout_gravity="bottom" android:orientation="horizontal" android:background="@drawable/bg_bottom_nav" android:elevation="16dp" android:paddingTop="4dp" android:paddingBottom="3dp">

        <!-- Tab Local -->
        <LinearLayout android:id="@+id/tabLocal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="6dp" android:layout_marginVertical="2dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_tab_active" android:clickable="true" android:focusable="true">

            <ImageView android:id="@+id/tabLocalIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_movie_clap" android:tint="@color/green_accent" android:layout_marginBottom="4dp" android:contentDescription="@null"/>

            <TextView android:id="@+id/tabLocalText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_blaze_video" android:textColor="@color/green_accent" android:textSize="12sp" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:includeFontPadding="false"/>

        </LinearLayout>

        <!-- Tab Réseau -->
        <LinearLayout android:id="@+id/tabNetwork" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="6dp" android:layout_marginVertical="2dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_tab_inactive" android:clickable="true" android:focusable="true">

            <ImageView android:id="@+id/tabNetworkIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_network" android:tint="@color/on_surface_variant" android:layout_marginBottom="4dp" android:contentDescription="@null"/>

            <TextView android:id="@+id/tabNetworkText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_network" android:textColor="@color/on_surface_variant" android:textSize="12sp" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:includeFontPadding="false"/>

        </LinearLayout>

        <!-- Tab Blaze Gallery -->
        <LinearLayout android:id="@+id/tabGallery" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="6dp" android:layout_marginVertical="2dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_tab_inactive" android:clickable="true" android:focusable="true">

            <ImageView android:id="@+id/tabGalleryIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_gallery" android:tint="@color/on_surface_variant" android:layout_marginBottom="4dp" android:contentDescription="@null"/>

            <TextView android:id="@+id/tabGalleryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name_gallery" android:textColor="@color/on_surface_variant" android:textSize="12sp" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:includeFontPadding="false"/>

        </LinearLayout>

        <!-- Tab Blaze Audio -->
        <LinearLayout android:id="@+id/tabAudio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="6dp" android:layout_marginVertical="2dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_tab_inactive" android:clickable="true" android:focusable="true">

            <ImageView android:id="@+id/tabAudioIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_music_note_large" android:tint="@color/on_surface_variant" android:layout_marginBottom="4dp" android:contentDescription="@null"/>

            <TextView android:id="@+id/tabAudioText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Blaze Audio" android:textColor="@color/on_surface_variant" android:textSize="12sp" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:includeFontPadding="false"/>

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
