<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnCloseEq"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/on_surface_variant"
            android:contentDescription="@string/close" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/equalizer"
            android:textColor="@color/on_background"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:id="@+id/tvEqStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/eq_status_on"
            android:textColor="@color/green_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchEq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#1FFFFFFF" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/eqBandsCard"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_surface_card"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/bandsContainer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:layout_width="28dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="+10"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="9sp"
                        android:gravity="top|center_horizontal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="0"
                        android:textColor="@color/green_accent"
                        android:textSize="9sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="-10"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="9sp"
                        android:gravity="bottom|center_horizontal" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvPresetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/presets_section"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/presetContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp"
                android:layout_marginBottom="18dp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/advancedTabs"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_equalizer_tabs_clip"
                android:foreground="@drawable/bg_equalizer_tabs_outline"
                android:foregroundGravity="fill"
                android:clipToOutline="true"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabTone"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="26dp"
                    app:backgroundTint="@color/equalizer_tab_background"
                    app:strokeColor="@android:color/transparent"
                    app:strokeWidth="0dp"
                    android:textColor="@color/equalizer_tab_text"
                    android:text="@string/eq_tab_tone"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabDynamics"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="26dp"
                    app:backgroundTint="@color/equalizer_tab_background"
                    app:strokeColor="@android:color/transparent"
                    app:strokeWidth="0dp"
                    android:textColor="@color/equalizer_tab_text"
                    android:text="@string/eq_tab_dynamics"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabAmbience"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="26dp"
                    app:backgroundTint="@color/equalizer_tab_background"
                    app:strokeColor="@android:color/transparent"
                    app:strokeWidth="0dp"
                    android:textColor="@color/equalizer_tab_text"
                    android:text="@string/eq_tab_ambience"
                    android:textAllCaps="false"
                    android:textSize="12sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- TONALITÉ -->
            <LinearLayout
                android:id="@+id/panelTone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_card"
                android:padding="14dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvToneUnavailable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:text="@string/eq_equalizer_unavailable"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:paddingBottom="8dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:alignmentMode="alignMargins"
                    android:useDefaultMargins="true">

                    <LinearLayout
                        android:id="@+id/bassContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <fr.retrospare.blazeplayer.player.RotaryKnobView
                            android:id="@+id/knobBass"
                            android:layout_width="120dp"
                            android:layout_height="120dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/eq_bass"
                            android:textColor="@color/on_background"
                            android:textStyle="bold"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/tvBassToneValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0,0 dB"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/trebleContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <fr.retrospare.blazeplayer.player.RotaryKnobView
                            android:id="@+id/knobTreble"
                            android:layout_width="120dp"
                            android:layout_height="120dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/eq_treble"
                            android:textColor="@color/on_background"
                            android:textStyle="bold"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/tvTrebleToneValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0,0 dB"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <fr.retrospare.blazeplayer.player.RotaryKnobView
                            android:id="@+id/knobBalance"
                            android:layout_width="120dp"
                            android:layout_height="120dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/eq_balance"
                            android:textColor="@color/on_background"
                            android:textStyle="bold"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/tvBalanceValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/eq_center"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <fr.retrospare.blazeplayer.player.RotaryKnobView
                            android:id="@+id/knobStereo"
                            android:layout_width="120dp"
                            android:layout_height="120dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/eq_stereo"
                            android:textColor="@color/on_background"
                            android:textStyle="bold"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/tvStereoValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="13sp" />
                    </LinearLayout>
                </GridLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMono"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/eq_mono"
                    android:textAllCaps="false"
                    android:checkable="true"
                    app:icon="@drawable/ic_audio"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <!-- DYNAMIQUE -->
            <LinearLayout
                android:id="@+id/panelDynamics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_card"
                android:padding="14dp"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:alignmentMode="alignMargins"
                    android:useDefaultMargins="true">

                    <LinearLayout
                        android:id="@+id/preampContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <fr.retrospare.blazeplayer.player.RotaryKnobView
                            android:id="@+id/knobPreamp"
                            android:layout_width="124dp"
                            android:layout_height="124dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/eq_preamp_label"
                            android:textColor="@color/on_background"
                            android:textStyle="bold"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/tvPreampKnobValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0,0 dB"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/compressorContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <fr.retrospare.blazeplayer.player.RotaryKnobView
                            android:id="@+id/knobCompressor"
                            android:layout_width="124dp"
                            android:layout_height="124dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/eq_compressor_label"
                            android:textColor="@color/on_background"
                            android:textStyle="bold"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/tvCompressorKnobValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="13sp" />
                    </LinearLayout>
                </GridLayout>

                <LinearLayout
                    android:id="@+id/loudnessContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp">
                    <fr.retrospare.blazeplayer.player.RotaryKnobView
                        android:id="@+id/knobLoudness"
                        android:layout_width="132dp"
                        android:layout_height="132dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/eq_loudness"
                        android:textColor="@color/on_background"
                        android:textStyle="bold"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tvLoudnessValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchSurround"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/eq_surround"
                    android:textColor="@color/on_background"
                    android:paddingVertical="8dp" />

                <TextView
                    android:id="@+id/tvSurroundSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/eq_surround_summary"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:id="@+id/surroundStrengthContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginBottom="10dp">
                    <fr.retrospare.blazeplayer.player.RotaryKnobView
                        android:id="@+id/knobSurroundStrength"
                        android:layout_width="132dp"
                        android:layout_height="132dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/eq_surround_strength"
                        android:textColor="@color/on_background"
                        android:textStyle="bold"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tvSurroundStrengthValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="55%"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAutoHeadroom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/eq_auto_headroom"
                    android:textColor="@color/on_background"
                    android:paddingVertical="8dp" />

                <TextView
                    android:id="@+id/tvAutoHeadroomSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/eq_auto_headroom_summary"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchLimiter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/eq_limiter"
                    android:textColor="@color/on_background"
                    android:paddingVertical="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/eq_limiter_summary"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- AMBIANCE -->
            <LinearLayout
                android:id="@+id/panelAmbience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_card"
                android:padding="14dp"
                android:visibility="gone"
                android:layout_marginBottom="24dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchReverb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/eq_reverb"
                    android:textColor="@color/on_background"
                    android:paddingVertical="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/eq_room_type"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/reverbPresetGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="12dp">
                    <fr.retrospare.blazeplayer.player.RotaryKnobView
                        android:id="@+id/knobReverbMix"
                        android:layout_width="146dp"
                        android:layout_height="146dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/eq_reverb_mix"
                        android:textColor="@color/on_background"
                        android:textStyle="bold"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tvReverbMixValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ReplayGain reste indépendant du toggle Réglages son et de la sortie directe. -->
            <LinearLayout
                android:id="@+id/replayGainCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_card"
                android:padding="14dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/audio_replaygain_title"
                    android:textColor="@color/on_background"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/audio_replaygain_subtitle"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/replayGainGroup"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_equalizer_tabs_clip"
                    android:foreground="@drawable/bg_equalizer_tabs_outline"
                    android:foregroundGravity="fill"
                    android:clipToOutline="true"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReplayGainOff"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/audio_replaygain_off"
                        android:textAllCaps="false"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeStepGranularity="1sp"
                        app:cornerRadius="26dp"
                        app:backgroundTint="@color/equalizer_tab_background"
                        app:strokeColor="@android:color/transparent"
                        app:strokeWidth="0dp"
                        android:textColor="@color/equalizer_tab_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReplayGainTrack"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/audio_replaygain_track"
                        android:textAllCaps="false"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeStepGranularity="1sp"
                        app:cornerRadius="26dp"
                        app:backgroundTint="@color/equalizer_tab_background"
                        app:strokeColor="@android:color/transparent"
                        app:strokeWidth="0dp"
                        android:textColor="@color/equalizer_tab_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReplayGainAlbum"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/audio_replaygain_album"
                        android:textAllCaps="false"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeStepGranularity="1sp"
                        app:cornerRadius="26dp"
                        app:backgroundTint="@color/equalizer_tab_background"
                        app:strokeColor="@android:color/transparent"
                        app:strokeWidth="0dp"
                        android:textColor="@color/equalizer_tab_text" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
