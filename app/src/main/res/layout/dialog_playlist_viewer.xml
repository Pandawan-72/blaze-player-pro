<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="#33FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvPlaylistSheetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="1"
            android:textColor="@color/on_background"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlaylistSheetClear"
            android:includeFontPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="14dp"
            android:textColor="@color/red_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            app:backgroundTint="@color/surface_variant"
            app:cornerRadius="20dp"
            app:strokeColor="@color/red_accent"
            app:strokeWidth="1dp"     android:insetTop="0dp"
            android:insetBottom="0dp" />

        <ImageButton
            android:id="@+id/btnClosePlaylistSheet"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_close"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            android:tint="@color/on_surface_variant" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginBottom="4dp"
        android:background="#1FFFFFFF" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPlaylistTracks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="4dp"
        android:overScrollMode="always"
        android:scrollbarStyle="insideInset" />

    <TextView
        android:id="@+id/tvPlaylistSheetEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingVertical="28dp"
        android:paddingHorizontal="24dp"
        android:text="@string/dialog_playlist_empty_message"
        android:textColor="@color/on_surface_variant"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlaylistSheetSecondary"
            android:includeFontPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="14dp"
            android:textColor="@color/green_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:visibility="gone"
            app:backgroundTint="@color/surface_variant"
            app:cornerRadius="20dp"
            app:strokeColor="@color/green_accent"
            app:strokeWidth="1dp"     android:insetTop="0dp"
            android:insetBottom="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlaylistSheetPlayAll"
            android:includeFontPadding="false"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/action_play_playlist"
            android:textColor="@color/green_accent"
            android:textSize="13sp"
            app:backgroundTint="@color/surface_variant"
            app:cornerRadius="20dp"
            app:strokeColor="@color/green_accent"
            app:strokeWidth="1dp"
            app:icon="@drawable/ic_play_small"
            app:iconGravity="textStart"
            app:iconTint="@color/green_accent"     android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

</LinearLayout>
