<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_surface_card"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/on_surface_variant"
            android:contentDescription="Retour"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/category_network"
                android:textColor="@color/on_background"
                android:textSize="18sp"
                android:fontFamily="sans-serif-condensed"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                android:fontFamily="sans-serif-condensed"
                android:singleLine="true"
                android:ellipsize="middle" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_surface_card"
            android:src="@drawable/ic_home"
            android:tint="@color/on_surface_variant"
            android:contentDescription="Accueil" />

    </LinearLayout>

    <!-- COMPTEUR + TRI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/loading"
            android:textColor="@color/blue_accent"
            android:textSize="13sp"
            android:fontFamily="sans-serif-condensed" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_equalizer"
            android:tint="@color/on_surface_variant"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvSortLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/name_label"
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp"
            android:fontFamily="sans-serif-condensed"
            android:layout_marginEnd="2dp" />

        <ImageView
            android:id="@+id/btnSortChevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_down"
            android:tint="@color/on_surface_variant"
            android:contentDescription="Trier"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ACTIONS VIDÉO FIXES -->
    <LinearLayout
        android:id="@+id/videoSelectionActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="10dp"
        android:background="@color/background">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToPlaylist"
            android:includeFontPadding="false"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:text="@string/add_to_playlist_fixed_short"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_add_circle"
            app:iconSize="16dp"
            app:iconTint="@color/green_accent"
            app:iconGravity="textStart"
            app:backgroundTint="@color/surface_variant"
            app:cornerRadius="22dp"
            app:strokeColor="@color/green_accent"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToQueue"
            android:includeFontPadding="false"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:text="@string/add_to_video_queue_short"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_add_circle"
            app:iconSize="16dp"
            app:iconTint="@color/black"
            app:iconGravity="textStart"
            app:backgroundTint="@color/green_accent"
            app:cornerRadius="22dp" />

    </LinearLayout>

    <!-- LISTE -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerNetwork"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="8dp"
        android:clipToPadding="false" />

</LinearLayout>
