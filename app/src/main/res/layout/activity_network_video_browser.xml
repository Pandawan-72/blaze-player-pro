<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- Carte premium navigateur réseau : navigation + tri + actions regroupés comme Local/Réseau -->
    <LinearLayout
        android:id="@+id/networkBrowserHeaderCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:background="@drawable/bg_header_premium"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="48dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <!-- Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_header_action_button"
                android:contentDescription="@string/content_desc_back"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/on_surface_variant" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="@string/category_network"
                    android:textColor="@color/on_background"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="middle"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_header_action_button"
                android:contentDescription="@string/breadcrumb_home"
                android:padding="9dp"
                android:src="@drawable/ic_home"
                android:tint="@color/on_surface_variant" />

        </LinearLayout>

        <!-- Actions vidéo fixes -->
        <LinearLayout
            android:id="@+id/videoSelectionActions"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddToPlaylist"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/add_to_playlist_fixed_short"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/surface_variant"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_add_circle"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="@color/green_accent"
                app:strokeColor="@color/green_accent"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddToQueue"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/add_to_video_queue_short"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/green_accent"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_add_circle"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="@color/black" />

        </LinearLayout>

        <!-- Compteur + tri -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:text="@string/loading"
                android:textColor="@color/green_accent"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/networkSortChip"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_header_action_button"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_equalizer"
                    android:tint="@color/green_accent" />

                <TextView
                    android:id="@+id/tvSortLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="3dp"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:text="@string/name_label"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnSortChevron"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:clickable="true"
                    android:contentDescription="@string/content_desc_sort"
                    android:focusable="true"
                    android:src="@drawable/ic_chevron_down"
                    android:tint="@color/on_surface_variant" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- LISTE : collée au bas de la carte -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerNetwork"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="8dp"
        android:clipToPadding="false" />

</LinearLayout>
