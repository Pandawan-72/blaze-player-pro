<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:paddingBottom="60dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:background="@color/background">

        <ImageButton
            android:id="@+id/btnCloseVideoQueue"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_down"
            android:tint="@color/on_surface"
            android:contentDescription="@string/content_desc_close_video_queue"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvVideoQueueTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/video_queue_title"
            android:textColor="@color/on_surface_variant"
            android:textSize="11sp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVideoQueueToPlaylist"
            android:includeFontPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:text="@string/action_to_playlist"
            android:textColor="@color/on_surface"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            app:icon="@drawable/ic_layout_list"
            app:iconSize="14dp"
            app:iconTint="@color/green_accent"
            app:iconGravity="textStart"
            app:backgroundTint="@color/surface_variant"
            app:strokeColor="@color/green_accent"
            app:strokeWidth="1dp"
            app:cornerRadius="22dp"
            android:contentDescription="@string/content_desc_queue_to_playlist" />

        <TextView
            android:id="@+id/btnClearVideoQueue"
            android:layout_width="56dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:includeFontPadding="false"
            android:gravity="center"
            android:textAlignment="center"
            android:text="−"
            android:textSize="21sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:textColor="@color/red_accent"
            android:background="@drawable/bg_queue_action_remove_pill"
            android:contentDescription="@string/content_desc_clean" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerVideoQueue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="always"
            android:paddingBottom="24dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/tvVideoQueueEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingHorizontal="28dp"
            android:text="@string/video_queue_empty_message"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp"
            android:fontFamily="sans-serif-condensed"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
