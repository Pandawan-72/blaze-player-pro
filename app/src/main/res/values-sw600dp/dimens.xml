<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Sur tablette, l'écran plein écran du lecteur audio ne doit pas s'étirer d'un bord à
         l'autre : ça donnerait des boutons/textes disproportionnés sur un écran 10". On plafonne
         la largeur utile via une marge horizontale généreuse, qui centre le contenu dans une
         colonne de largeur raisonnable — même principe que Spotify/Apple Music sur tablette. -->
    <dimen name="audio_player_horizontal_margin">96dp</dimen>

<!-- La rangée supérieure reste proche de la barre système afin de préserver davantage
         d'espace sous les commandes du lecteur et au-dessus des onglets de navigation. -->
    <dimen name="audio_player_top_padding">6dp</dimen>
    <dimen name="audio_player_artwork_top_gap">12dp</dimen>
    <dimen name="audio_player_bottom_padding">20dp</dimen>
</resources>
