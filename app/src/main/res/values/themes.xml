    <!-- Tous les vrais boutons pilule Material de l'application héritent de ce rendu.
         La navigation inférieure utilise ses propres LinearLayout/drawables et n'est pas touchée. -->
    <style name="Widget.BlazePlayer.Button" parent="Widget.Material3.Button">
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">7sp</item>
        <item name="autoSizeMaxTextSize">16sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
        <item name="android:singleLine">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">none</item>

        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.015</item>
        <item name="cornerRadius">24dp</item>
        <item name="strokeColor">@color/premium_pill_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/premium_pill_ripple</item>
        <item name="android:foreground">@drawable/bg_premium_pill_foreground</item>
        <item name="android:foregroundGravity">fill</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:elevation">3dp</item>
        <item name="android:shadowColor">#B3000000</item>
        <item name="android:stateListAnimator">@animator/premium_pill_state_animator</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.BlazePlayer.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="autoSizeTextType">uniform</item>
