<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BlazePlayer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="fontFamily">sans-serif-condensed</item>
        <item name="colorPrimary">@color/green_accent</item>
        <item name="colorOnPrimary">@color/background</item>
        <item name="colorPrimaryContainer">@color/green_container</item>
        <item name="colorOnPrimaryContainer">@color/on_green_container</item>
        <item name="colorSecondary">@color/blue_accent</item>
        <item name="colorOnSecondary">@color/background</item>
        <item name="colorTertiary">@color/blue_accent</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">#0D0F14</item>
        <item name="colorOnSurface">@color/on_background</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error_color</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.BlazePlayer.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.BlazePlayer.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.BlazePlayer.Dialog</item>
        <item name="popupMenuStyle">@style/Widget.BlazePlayer.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.BlazePlayer.PopupMenu</item>
        <item name="android:windowActionModeOverlay">true</item>
        <!-- Texte en gras sur tous les boutons de l'app (visibilité/accessibilité) : un seul
             endroit à changer puisqu'aucun MaterialButton du projet ne déclare de style="..."
             explicite — ils héritent tous de ce style par défaut. -->
        <item name="materialButtonStyle">@style/Widget.BlazePlayer.Button</item>
    </style>

    <style name="Widget.BlazePlayer.Button" parent="Widget.Material3.Button">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Thème lecteur vidéo — plein écran total, fond noir -->
    <style name="Theme.BlazePlayer.Fullscreen" parent="Theme.BlazePlayer">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:colorBackground">@color/player_background</item>
        <item name="android:statusBarColor">@color/player_background</item>
        <item name="android:navigationBarColor">@color/player_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="ThemeOverlay.BlazePlayer.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BlazeBottomSheet</item>
    </style>

    <style name="BlazeBottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">#0D0F14</item>
        <item name="shapeAppearance">@style/ShapeAppearance.BlazePlayer.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.BlazePlayer.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
    </style>

    <style name="ThemeOverlay.BlazePlayer.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">#0D0F14</item>
        <item name="colorOnSurface">@color/on_background</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BlazePlayer.Dialog</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="fontFamily">sans-serif-condensed</item>
        <item name="android:windowBackground">@drawable/bg_modal_video_style</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.72</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.BlazePlayer.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.BlazePlayer.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.BlazePlayer.DialogButton</item>
    </style>

    <style name="ShapeAppearance.BlazePlayer.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

</resources>
