        <!-- Texte en gras sur tous les boutons de l'app (visibilité/accessibilité) : un seul
             endroit à changer puisqu'aucun MaterialButton du projet ne déclare de style="..."
             explicite — ils héritent tous de ce style par défaut. -->
        <item name="materialButtonStyle">@style/Widget.BlazePlayer.Button</item>
        <item name="android:buttonStyle">@style/Widget.BlazePlayer.PlatformButton</item>
        <item name="buttonStyle">@style/Widget.BlazePlayer.PlatformButton</item>
