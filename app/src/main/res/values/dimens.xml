<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Écran audio plein écran : marge horizontale qui plafonne la largeur du contenu sur les
         grands écrans (tablettes) — voir values-sw600dp pour la valeur tablette. Sur téléphone,
         aucune marge : le contenu garde toute la largeur comme avant. -->
    <dimen name="audio_player_horizontal_margin">0dp</dimen>

    <!-- Titre et nom d'artiste (même ligne, séparés par un tiret) : même taille pour les deux,
         plus grande sur tablette. -->
    <dimen name="audio_player_title_text_size">24sp</dimen>

    <!-- Décale légèrement le bloc cover + commandes vers le bas pour aérer l'espace entre
         la barre Party/file d'attente du haut et la pochette, en récupérant l'espace libre sous
         les boutons EQ/minuteur/infos. -->
    <dimen name="audio_player_top_padding">8dp</dimen>
    <dimen name="audio_player_artwork_top_gap">14dp</dimen>
    <dimen name="audio_player_bottom_padding">34dp</dimen>
</resources>
