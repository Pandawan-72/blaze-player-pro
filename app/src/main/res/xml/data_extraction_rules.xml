<?xml version="1.0" encoding="utf-8"?>
<!--
    Règles de backup/restauration pour Android 12+.
    Les mêmes exclusions sont appliquées au backup cloud et au transfert appareil-à-appareil.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/blaze_player_settings.preferences_pb" />
        <exclude domain="file" path="blaze_audio_library_premium_index_v1.json" />
        <exclude domain="database" path="blaze_audio_library_room.db" />

        <exclude domain="sharedpref" path="blaze_favorite_folders.xml" />
        <exclude domain="sharedpref" path="blaze_positions.xml" />
        <exclude domain="sharedpref" path="blaze_audio_pro_settings.xml" />
        <exclude domain="sharedpref" path="blaze_audio_playback_history.xml" />
        <exclude domain="sharedpref" path="blaze_audio_watched_library_cache.xml" />
        <exclude domain="sharedpref" path="blaze_audio_library_premium_ui.xml" />
        <exclude domain="sharedpref" path="blaze_audio_library_scan_state.xml" />
        <exclude domain="sharedpref" path="blaze_playlist_v3.xml" />
        <exclude domain="sharedpref" path="blaze_saved_playlists.xml" />
        <exclude domain="sharedpref" path="blaze_video_queues.xml" />
        <exclude domain="sharedpref" path="blaze_gallery.xml" />

        <exclude domain="sharedpref" path="blaze_video_metadata_cache.xml" />
        <exclude domain="sharedpref" path="blaze_audio_metadata_cache.xml" />
        <exclude domain="sharedpref" path="blaze_audio_loudness_cache.xml" />
        <exclude domain="sharedpref" path="blaze_audio_album_loudness_cache.xml" />
        <exclude domain="sharedpref" path="blaze_audio_metadata_overrides.xml" />
        <exclude domain="sharedpref" path="blaze_audio_dynamic_colors.xml" />
        <exclude domain="sharedpref" path="blaze_runtime_permissions.xml" />
        <exclude domain="sharedpref" path="launcher_requests.xml" />
        <exclude domain="sharedpref" path="blaze_party_local_snapshot.xml" />
        <exclude domain="sharedpref" path="blaze_party_votes.xml" />
        <exclude domain="sharedpref" path="blaze_party_dedicated_playlist.xml" />
    </cloud-backup>

    <device-transfer>
        <exclude domain="file" path="datastore/blaze_player_settings.preferences_pb" />
        <exclude domain="file" path="blaze_audio_library_premium_index_v1.json" />
        <exclude domain="database" path="blaze_audio_library_room.db" />

        <exclude domain="sharedpref" path="blaze_favorite_folders.xml" />
        <exclude domain="sharedpref" path="blaze_positions.xml" />
        <exclude domain="sharedpref" path="blaze_audio_pro_settings.xml" />
        <exclude domain="sharedpref" path="blaze_audio_playback_history.xml" />
        <exclude domain="sharedpref" path="blaze_audio_watched_library_cache.xml" />
        <exclude domain="sharedpref" path="blaze_audio_library_premium_ui.xml" />
        <exclude domain="sharedpref" path="blaze_audio_library_scan_state.xml" />
        <exclude domain="sharedpref" path="blaze_playlist_v3.xml" />
        <exclude domain="sharedpref" path="blaze_saved_playlists.xml" />
        <exclude domain="sharedpref" path="blaze_video_queues.xml" />
        <exclude domain="sharedpref" path="blaze_gallery.xml" />

        <exclude domain="sharedpref" path="blaze_video_metadata_cache.xml" />
        <exclude domain="sharedpref" path="blaze_audio_metadata_cache.xml" />
        <exclude domain="sharedpref" path="blaze_audio_loudness_cache.xml" />
        <exclude domain="sharedpref" path="blaze_audio_album_loudness_cache.xml" />
        <exclude domain="sharedpref" path="blaze_audio_metadata_overrides.xml" />
        <exclude domain="sharedpref" path="blaze_audio_dynamic_colors.xml" />
        <exclude domain="sharedpref" path="blaze_runtime_permissions.xml" />
        <exclude domain="sharedpref" path="launcher_requests.xml" />
        <exclude domain="sharedpref" path="blaze_party_local_snapshot.xml" />
        <exclude domain="sharedpref" path="blaze_party_votes.xml" />
        <exclude domain="sharedpref" path="blaze_party_dedicated_playlist.xml" />
    </device-transfer>
</data-extraction-rules>
