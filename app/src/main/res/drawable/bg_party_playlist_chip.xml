<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#5B4618" android:endColor="#231906" />
            <stroke android:width="1dp" android:color="#FFFFD45E" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#66501C" android:centerColor="#3D2C0D" android:endColor="#1D1506" />
            <stroke android:width="1dp" android:color="#FFFFC107" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#302C22" android:centerColor="#1C1A16" android:endColor="#0D1118" />
            <stroke android:width="1dp" android:color="#C8FFC107" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
