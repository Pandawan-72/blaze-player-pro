<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#47242E" android:endColor="#1A1118" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#FFF06C72" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#30202B" android:centerColor="#1B1821" android:endColor="#0C1119" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#D9F05A62" />
        </shape>
    </item>
</selector>
