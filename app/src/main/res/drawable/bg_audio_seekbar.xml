<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:top="13dp" android:bottom="13dp">
        <shape>
            <size android:height="2dp" />
            <solid android:color="#45889091" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:top="13dp" android:bottom="13dp">
        <clip>
            <shape>
                <size android:height="2dp" />
                <solid android:color="?attr/blazeAccentStroke" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress" android:top="13dp" android:bottom="13dp">
        <clip>
            <shape>
                <size android:height="2dp" />
                <gradient android:startColor="?attr/colorPrimary" android:centerColor="?attr/colorPrimary" android:endColor="?attr/blazeAccentDarkBorder" android:angle="0" />
            </shape>
        </clip>
    </item>
</layer-list>
