<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#294338" android:endColor="#0F211A" />
            <stroke android:width="1dp" android:color="?attr/blazeAccentStrong" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#274137" android:centerColor="#192C26" android:endColor="#0D1714" />
            <stroke android:width="1dp" android:color="?attr/blazeAccentStrong" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#273346" android:centerColor="#182231" android:endColor="#0B111A" />
            <stroke android:width="1dp" android:color="#789EA8BA" />
        </shape>
    </item>
</selector>
