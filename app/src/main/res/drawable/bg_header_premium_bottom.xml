<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:startColor="#111E2F"
                android:centerColor="#0B111D"
                android:endColor="#050812" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="24dp"
                android:bottomRightRadius="24dp" />
            <stroke android:width="0.8dp" android:color="#2A21E69A" />
        </shape>
    </item>
    <item android:left="1dp" android:top="0dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#08FFFFFF"
                android:endColor="#00000000" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="23dp"
                android:bottomRightRadius="23dp" />
        </shape>
    </item>
</layer-list>
