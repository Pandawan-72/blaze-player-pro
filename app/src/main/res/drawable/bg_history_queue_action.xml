<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#243D34"
                android:endColor="#0A1712" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#20392F"
                android:endColor="#0B1713" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#172235"
                android:endColor="#0A101B" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="?attr/blazeAccentStroke" />
        </shape>
    </item>
</selector>
