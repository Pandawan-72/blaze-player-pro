<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#66465B53" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#28D99A" android:endColor="#10B773" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#B8C9FFEA" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#4AF0B8" android:centerColor="#25DB98" android:endColor="#12BD76" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#8FEAFFF7" />
        </shape>
    </item>
</selector>
