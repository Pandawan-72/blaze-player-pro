<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/audio_library_accent_soft" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/audio_library_accent" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#66111A28" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#44B9DFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#B0111A28" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/audio_library_accent_stroke" />
        </shape>
    </item>
</selector>
