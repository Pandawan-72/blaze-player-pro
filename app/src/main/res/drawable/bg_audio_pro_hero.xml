<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:startColor="#29112C"
                android:centerColor="#101827"
                android:endColor="#050812" />
            <corners android:radius="26dp" />
            <stroke android:width="0.9dp" android:color="#80E46BDB" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#18FFFFFF"
                android:centerColor="#083A1D42"
                android:endColor="#00000000" />
            <corners android:radius="25dp" />
        </shape>
    </item>
</layer-list>
