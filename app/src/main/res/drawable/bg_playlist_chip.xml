<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#30D99A" android:endColor="#0FB575" />
            <stroke android:width="1dp" android:color="#C9CBFFEE" />
        </shape>
    </item>
    <item android:state_selected="true" android:state_activated="true">
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#4AF0B8" android:centerColor="#29DC9C" android:endColor="#13BD78" />
            <stroke android:width="1dp" android:color="#B421E69A" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#43EAAF" android:centerColor="#25D596" android:endColor="#12B975" />
            <stroke android:width="1dp" android:color="#A121E69A" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#273449" android:centerColor="#182231" android:endColor="#0A1018" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
        </shape>
    </item>
</selector>
