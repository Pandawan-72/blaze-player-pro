<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dernière playlist lue : chip plein premium. -->
    <item android:state_selected="true" android:state_activated="true">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#27F0A3"
                android:endColor="#15C982" />
            <stroke android:width="1dp" android:color="#9921E69A" />
        </shape>
    </item>
    <!-- Playlist non vide : chip vert rempli, avec chiffre noir pour une bonne lisibilité. -->
    <item android:state_selected="true">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#27F0A3"
                android:endColor="#15C982" />
            <stroke android:width="1dp" android:color="#9921E69A" />
        </shape>
    </item>
    <!-- Playlist vide : discrète, plus premium. -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#0E1420" />
            <stroke android:width="0.8dp" android:color="#2EFFFFFF" />
        </shape>
    </item>
</selector>
