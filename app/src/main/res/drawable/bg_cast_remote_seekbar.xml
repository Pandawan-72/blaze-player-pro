<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:top="14dp" android:bottom="14dp">
        <shape android:shape="rectangle">
            <size android:height="6dp" />
            <corners android:radius="3dp" />
            <gradient android:angle="270" android:startColor="#344154" android:endColor="#1A2330" />
            <stroke android:width="1dp" android:color="#52647A" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:top="14dp" android:bottom="14dp">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="6dp" />
                <corners android:radius="3dp" />
                <solid android:color="#5C7189" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress" android:top="14dp" android:bottom="14dp">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="6dp" />
                <corners android:radius="3dp" />
                <gradient android:angle="0" android:startColor="#B9DFFF" android:endColor="#6EB9ED" />
            </shape>
        </clip>
    </item>
</layer-list>
