<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Réseau -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Requis depuis Android 13 (API 33) pour la decouverte mDNS/NSD utilisee par Google Cast -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />

    <!-- Stockage Android 9-12 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Stockage Android 13+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Visualiseur audio : analyse FFT de la session de lecture -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Wake lock lecture -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Notifications Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <queries>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".BlazePlayerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BlazePlayer"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true"
        android:largeHeap="true">

        <!-- Déclare Blaze Audio comme application média compatible Android Auto. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- largeHeap : marge de sécurité supplémentaire pour la lecture vidéo réseau (SMB) qui
             combine tampon de lecture, miniatures et extraction de métadonnées en parallèle.
             Ajouté suite à un OutOfMemoryError observé sur un tas cible de 256 Mo (le vrai fix
             est la réduction des tailles de buffer SMB, cf. SmbClientPool/SmbMediaDataSource). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BlazePlayer"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="blazeparty" android:host="join" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bp" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Certains scanners ne parsèment pas les Android Intent URI et envoient
                     littéralement intent://... à Android. On capte aussi ce format pour éviter
                     que le QR termine dans le menu natif de partage. -->
                <data android:scheme="intent" android:host="join" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="blazeparty.local" android:pathPrefix="/join" />
                <data android:scheme="http" android:host="blazeparty.local" android:pathPrefix="/join" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BlazeGalleryLauncherActivity"
            android:enabled="true"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@mipmap/ic_blaze_gallery_launcher"
            android:label="@string/app_name_gallery"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:taskAffinity="fr.retrospare.blazeplayer.gallery"
            android:roundIcon="@mipmap/ic_blaze_gallery_launcher_round"
            android:theme="@android:style/Theme.NoDisplay">
            <!-- taskAffinity dédiée + singleInstance : certains launchers/ROM ne relancent pas
                 réellement une activité qui partage l'affinité de tâche par défaut de l'app
                 (celle de MainActivity) quand une tâche de cette app existe déjà — ils se
                 contentent de ramener cette tâche au premier plan sans exécuter onCreate() de
                 BlazeGalleryLauncherActivity ni onNewIntent() de MainActivity. Résultat : l'icône
                 "Blaze Gallery" rouvrait Blaze Player sur son dernier onglet (souvent "Local")
                 au lieu de forcer l'onglet Blaze Gallery. Une tâche dédiée garantit que cette
                 activité (donc son trampoline vers MainActivity) s'exécute à chaque appui sur
                 l'icône, même quand Blaze Player tourne déjà en arrière-plan. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BlazeAudioLauncherActivity"
            android:enabled="true"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@mipmap/ic_blaze_audio_launcher"
            android:label="@string/app_name_audio"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:taskAffinity="fr.retrospare.blazeplayer.audio"
            android:roundIcon="@mipmap/ic_blaze_audio_launcher_round"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".player.BlazePlayerService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:label="@string/app_name_audio">
            <intent-filter>
                <!-- Media3 moderne : Android Auto / Android Automotive / MediaBrowser. -->
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <!-- Compatibilité avec les clients automobiles utilisant encore MediaBrowser. -->
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Permet la reprise de la dernière file Blaze Audio depuis Android Auto, les commandes
             Bluetooth et les contrôles système, même après recréation du service. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Service de lecture vidéo (ExoPlayer + CastPlayer) : démarré explicitement par
             PlayerActivity. Sa déclaration manquait précédemment, ce qui faisait planter
             startService() au runtime dès l'ouverture d'une vidéo. -->
        <service
            android:name=".player.VideoPlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService"/>
            </intent-filter>
        </service>


        <activity
            android:name=".player.AudioLibraryActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.BlazePlayer" />

        <activity
            android:name=".player.AudioProSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BlazePlayer" />

        <activity
            android:name=".player.AudioPlayerActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BlazePlayer">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".player.ChromecastRemoteActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BlazePlayer" />

        <activity
            android:name=".player.PlayerActivity"
            android:supportsPictureInPicture="true"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:launchMode="singleTop"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.BlazePlayer.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="video/x-matroska" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <activity
            android:name=".player.AudioBrowserActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BlazePlayer" />

        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="fr.retrospare.blazeplayer.cast.CastOptionsProvider" />

        <receiver
            android:name="androidx.mediarouter.media.MediaTransferReceiver"
            android:exported="false" />

        <activity
            android:name=".gallery.slideshow.SlideshowActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BlazePlayer" />

        <activity
            android:name=".gallery.slideshow.SlideshowPhotoPickerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BlazePlayer" />

        <activity
            android:name=".gallery.slideshow.AnnotationEditorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BlazePlayer" />

        <activity
            android:name=".gallery.edit.PhotoEditorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BlazePlayer" />

        <activity
            android:name=".gallery.edit.VideoTrimActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BlazePlayer" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".paywall.TrialReminderReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

</application>

</manifest>
