<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_audio"
        android:tint="@color/orange_accent"
        android:contentDescription="@null"
        android:layout_marginEnd="12dp" />

    <TextView
        android:id="@+id/tvAudioSimpleName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/on_surface"
        android:textSize="13sp"
        android:ellipsize="end"
        android:singleLine="true" />

    <TextView
        android:id="@+id/tvAudioSimpleCodec"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_gray"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:textSize="10sp"
        android:textColor="@color/on_surface_variant"
        android:fontFamily="sans-serif-condensed"
        android:layout_marginStart="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvAudioSimpleFormatBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_gray"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:textSize="10sp"
        android:textColor="@color/on_surface_variant"
        android:fontFamily="sans-serif-condensed"
        android:layout_marginStart="4dp"
        android:visibility="gone" />

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_play"
        android:tint="@color/on_surface_variant"
        android:contentDescription="@null" />

</LinearLayout>
