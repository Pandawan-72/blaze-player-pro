<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:startColor="#111E2F"
                android:centerColor="#0B111D"
                android:endColor="#050812" />
            <stroke android:width="0.8dp" android:color="#2A21E69A" />
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#10FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
